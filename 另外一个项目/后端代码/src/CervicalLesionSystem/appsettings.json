{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "CervicalLesionSystem": "Debug"
    },
    "DictConfig": {
      "Version": 1,
      "Formatters": {
        "DetailedFormatter": {
          "Format": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level}] {Message} {Exception}{NewLine}"
        }
      },
      "Handlers": {
        "FileHandler": {
          "Class": "System.IO.File",
          "Level": "Information",
          "Formatter": "DetailedFormatter",
          "FileName": "logs/application.log",
          "MaxFileSize": 10485760,
          "BackupCount": 5
        },
        "ConsoleHandler": {
          "Class": "System.Console",
          "Level": "Debug",
          "Formatter": "DetailedFormatter"
        }
      },
      "Loggers": {
        "DefaultLogger": {
          "Level": "Information",
          "Handlers": [ "ConsoleHandler", "FileHandler" ]
        }
      }
    }
  },
  "ConnectionStrings": {
    "MedicalDatabase": "Server=localhost;Database=CervicalLesionAssessment;Integrated Security=true;TrustServerCertificate=true;",
    "CacheDatabase": "Server=localhost;Database=LesionCache;Integrated Security=true;TrustServerCertificate=true;"
  },
  "ModelConfiguration": {
    "SegmentationModelPath": "models/lesion_segmentation.onnx",
    "ClassificationModelPath": "models/risk_classification.pb",
    "ModelCacheDirectory": "model_cache",
    "InferenceBatchSize": 8,
    "GpuDeviceId": 0,
    "EnableTensorRtOptimization": false
  },
  "ImageProcessing": {
    "StandardResolution": {
      "Width": 1024,
      "Height": 768
    },
    "SupportedFormats": [ ".dcm", ".tiff", ".png", ".jpg", ".bmp" ],
    "PreprocessingPipeline": [
      "NormalizeIntensity",
      "RemoveArtifacts",
      "EnhanceContrast"
    ],
    "CachedStoragePath": "cache_images",
    "CompressionQuality": 90
  },
  "RiskAssessment": {
    "Thresholds": {
      "LowRiskUpperBound": 0.3,
      "MediumRiskUpperBound": 0.7,
      "HighRiskUpperBound": 1.0
    },
    "WeightFactors": {
      "LesionArea": 0.35,
      "CellAbnormality": 0.40,
      "HistoricalConsistency": 0.25
    },
    "CalculationCacheDuration": "00:30:00"
  },
  "ReportGeneration": {
    "TemplateDirectory": "report_templates",
    "DefaultTemplate": "standard_report.html",
    "OutputFormats": [ "PDF", "HTML", "DOCX" ],
    "HospitalHeaderEnabled": true,
    "AutoSaveReports": true,
  },
  "ApplicationSettings": {
    "MaximumConcurrentAnalyses": 4,
    "ResultRetentionDays": 730,
    "BackupSchedule": "0 2 * * *",
    "EnableTelemetry": false,
    "DiagnosticMode": false
  },
  "ExternalServices": {
    "PacsEndpoint": "http://localhost:8080/pacs",
    "Hl7InterfaceEnabled": false,
    "AuditServiceUrl": "http://localhost:5001"
  },
  "Security": {
    "EncryptionKey": "",
    "RequireAuthentication": true,
    "SessionTimeout": "01:00:00",
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:3000" ]
  }
}