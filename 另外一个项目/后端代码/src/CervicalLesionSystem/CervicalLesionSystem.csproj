<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyName>CervicalLesionSystem</AssemblyName>
    <RootNamespace>CervicalLesionSystem</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>MedicalAI System</Authors>
    <Company>MedicalAI Solutions</Company>
    <Description>宫颈病变智能风险评估与辅助诊断系统</Description>
    <Copyright>© 2024 MedicalAI Solutions. All rights reserved.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/medicalai/cervical-lesion-system</PackageProjectUrl>
    <RepositoryUrl>https://github.com/medicalai/cervical-lesion-system.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>medical;ai;cervical;diagnosis;imaging</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- 核心.NET框架包 -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    
    <!-- 图像处理库 -->
    <PackageReference Include="OpenCvSharp4" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240103" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.3" />
    
    <!-- AI/ML相关库 -->
    <PackageReference Include="Microsoft.ML" Version="3.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.17.0" />
    <PackageReference Include="TensorFlow.NET" Version="0.100.2" />
    
    <!-- 序列化和JSON处理 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
    
    <!-- 数据验证 -->
    <PackageReference Include="FluentValidation" Version="11.9.0" />
    
    <!-- 实用工具库 -->
    <PackageReference Include="Polly" Version="8.3.1" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
    
    <!-- 医疗图像格式支持 -->
    <PackageReference Include="fo-dicom" Version="5.1.0" />
    
    <!-- 图表和报告生成 -->
    <PackageReference Include="QuestPDF" Version="2024.3.3" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinForms" Version="2.0.0-rc2.1" />
    
    <!-- 异步和并行处理 -->
    <PackageReference Include="System.Threading.Tasks.Dataflow" Version="8.0.0" />
    
    <!-- 内存缓存 -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 应用程序资源 -->
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Properties\launchSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    
    <!-- 智能算法文件 -->
    <Content Include="Models\**\*.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Models\**\*.pb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    
    <!-- 配置文件 -->
    <Content Include="Config\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    
    <!-- 资源文件 -->
    <Content Include="Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 排除验证文件 -->
    <Compile Remove="**\*Validate*.cs" />
    <Compile Remove="**\*Spec*.cs" />
    <Compile Remove="**\*Fixture*.cs" />
    <None Remove="**\*Validate*.cs" />
    <None Remove="**\*Spec*.cs" />
    <None Remove="**\*Fixture*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 编译时包含XML文档注释 -->
    <None Update="**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 确保必要的文件夹结构 -->
    <Folder Include="Core\" />
    <Folder Include="Services\" />
    <Folder Include="Models\" />
    <Folder Include="Utilities\" />
    <Folder Include="Logging\" />
    <Folder Include="Constants\" />
    <Folder Include="Config\" />
    <Folder Include="Resources\" />
    <Folder Include="Models\AI\" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <!-- 复制运行时依赖 -->
    <Copy SourceFiles="$(OutDir)OpenCvSharpExtern.dll" DestinationFolder="$(OutDir)" Condition="Exists('$(OutDir)OpenCvSharpExtern.dll')" />
  </Target>

  <PropertyGroup>
    <!-- 启用代码分析 -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    
    <!-- 生成文档文件 -->
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    
    <!-- 启用可为空引用类型 -->
    <Nullable>enable</Nullable>
    
    <!-- 启用隐式全局using -->
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- 启用C#最新语言特性 -->
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>