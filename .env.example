# 云端模型服务配置
VITE_API_BASE_URL=http://localhost:3000/api
VITE_MODEL_SERVICE_URL=https://cervix-ai-api.example.com
VITE_MAX_FILE_SIZE=50MB
VITE_SUPPORTED_FORMATS=.pth,.onnx,.pb,.h5

# 认证配置
VITE_AUTH_TOKEN_KEY=auth_token
VITE_REFRESH_TOKEN_KEY=refresh_token

# 上传配置
VITE_CHUNK_SIZE=10485760  # 10MB
VITE_MAX_CONCURRENT_UPLOADS=3